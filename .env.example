# Application name used in emails and page metadata.
APP_NAME="Aftercare Leaflet Generator"
APP_ENV=local
APP_KEY=
# Production must use APP_DEBUG=false to avoid exposing request and configuration data.
APP_DEBUG=true
# Base URL for generated links; never hard-code domains in application code.
APP_URL=http://localhost:8000

# Leave unset on cPanel; use * only behind a trusted ingress such as Render (render.yaml sets it).
# Kept commented out: an empty value in .env would be locked in by the immutable env repository.
# TRUSTED_PROXIES=*
# Disposable demo only: shows a warning and automatically verifies registrations.
DEMO_MODE=false
# Optional demo admin credentials; supply secrets in the Render dashboard only.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Container HTTP port (Render supplies PORT); not used on cPanel.
PORT=10000
# Render supplies this URL; used by docker/start.sh when APP_URL is unset.
RENDER_EXTERNAL_URL=

# Default language, fallback language, and factory data locale.
APP_LOCALE=et
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=et_EE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Production: set DB_DATABASE to an ABSOLUTE path outside the web root.
# Example: DB_DATABASE=/home/USER/data/staging/database.sqlite
# Local default (when unset): database/database.sqlite, resolved by database_path().
# DB_DATABASE=/home/USER/data/staging/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypt stored sessions: the wizard may contain a first name and procedure date.
SESSION_ENCRYPT=true
# Defaults to true in production; set false only for local HTTP development.
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Set to false only for a public demo with fictional content; real deployments must keep draft markings until clinic staff review the content.
LEAFLET_DRAFT_MARKS=true

# Chat kill switch: keep disabled until the clinic approves launch.
CHAT_ENABLED=false
# LLM driver: anthropic or fake (deterministic, no network).
LLM_PROVIDER=anthropic
# Provider secret; leave empty in examples and never commit a real key.
LLM_API_KEY=
# Model used by the selected provider.
LLM_MODEL=claude-opus-5-5
# Optional provider endpoint; empty uses the SDK default.
LLM_BASE_URL=
# Provider output effort.
LLM_EFFORT=low
# Provider request timeout in seconds.
LLM_TIMEOUT=20
# Global maximum chat requests per calendar day.
CHAT_DAILY_CAP=500
# Maximum characters in a message or history turn.
CHAT_MAX_CHARS=500
